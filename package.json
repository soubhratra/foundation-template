{
  "name": "foundation-template",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "pre-commit": "pre-commit run --all-files",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "cd apps/api && uv run python manage.py migrate",
    "db:makemigrations": "cd apps/api && uv run python manage.py makemigrations",
    "db:reset": "docker compose down -v && docker compose up -d && sleep 5 && cd apps/api && uv run python manage.py migrate",
    "setup": "pnpm install && cd apps/api && uv sync && cd ../.. && docker compose up -d && sleep 5 && cd apps/api && uv run python manage.py migrate",
    "generate:api-types": "node ./scripts/generate-api-types.mjs",
    "generate:types": "turbo run generate:api-types --filter=@repo/api"
  },
  "pnpm": {
    "overrides": {
      "@tanstack/react-query-devtools": "5.91.3"
    }
  },
  "devDependencies": {
    "@repo/config-eslint": "workspace:*",
    "@repo/config-ts": "workspace:*",
    "lint-staged": "^15.2.10",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.5.2",
    "turbo": "^2.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
