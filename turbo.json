{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "generate:api-types": {
      "cache": false,
      "inputs": ["apps/api/**/*.py", "apps/api/**/*.json"],
      "outputs": [
        "packages/api-client/openapi.json",
        "packages/api-client/src/gen/v1.d.ts"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
