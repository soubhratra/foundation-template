# apps/api/.env.example
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
DATABASE_URL=postgres://foundation:foundation@localhost:5432/foundation
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
DJANGO_SETTINGS_MODULE=config.settings.development

# OpenTelemetry — set to export traces to local Jaeger (docker compose up)
# Leave empty to disable tracing (CI, local dev without Jaeger)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=foundation-api

# OBSERVABILITY MODULE
# PostHog project API key — leave empty to use NoOpAdapter (zero overhead in CI/dev)
# Get your key from https://app.posthog.com/project/settings
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# END OBSERVABILITY MODULE

# BILLING MODULE
# Stripe API keys — replace with your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# Stripe Price IDs — replace with your price IDs from https://dashboard.stripe.com/products
STRIPE_PRICE_PRO_MONTHLY=price_REPLACE_WITH_PRO_MONTHLY_PRICE_ID
STRIPE_PRICE_PRO_ANNUAL=price_REPLACE_WITH_PRO_ANNUAL_PRICE_ID
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_REPLACE_WITH_ENTERPRISE_MONTHLY_PRICE_ID
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_REPLACE_WITH_ENTERPRISE_ANNUAL_PRICE_ID
# END BILLING MODULE
