<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Invoice {{ invoice.reference }}</title>
  <style>
    @page {
      size: A4;
      margin: 2cm;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 12pt;
      color: #111;
      background: #fff;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 2rem;
      border-bottom: 2px solid #333;
      padding-bottom: 1rem;
    }

    .header .brand {
      font-size: 20pt;
      font-weight: bold;
      letter-spacing: 0.05em;
    }

    .header .invoice-meta {
      text-align: right;
    }

    .header .invoice-meta .reference {
      font-size: 14pt;
      font-weight: bold;
      color: #333;
    }

    .header .invoice-meta .date {
      margin-top: 0.25rem;
      color: #555;
    }

    .section {
      margin-bottom: 1.5rem;
    }

    .section-title {
      font-size: 9pt;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #888;
      margin-bottom: 0.5rem;
    }

    .section-body {
      font-size: 11pt;
      color: #222;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 1.5rem;
    }

    thead tr {
      background: #f5f5f5;
      border-bottom: 1px solid #ddd;
    }

    thead th {
      padding: 0.5rem 0.75rem;
      text-align: left;
      font-size: 9pt;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #555;
    }

    tbody td {
      padding: 0.75rem;
      border-bottom: 1px solid #eee;
      font-size: 11pt;
    }

    .amount-row td {
      font-weight: bold;
      font-size: 12pt;
      background: #fafafa;
    }

    .footer {
      margin-top: 3rem;
      font-size: 9pt;
      color: #aaa;
      text-align: center;
      border-top: 1px solid #eee;
      padding-top: 0.75rem;
    }
  </style>
</head>
<body>

  <div class="header">
    <div class="brand">Invoice</div>
    <div class="invoice-meta">
      <div class="reference">{{ invoice.reference }}</div>
      <div class="date">{{ invoice.date }}</div>
    </div>
  </div>

  <div class="section">
    <div class="section-title">Billed To</div>
    <div class="section-body">{{ invoice.customer_email }}</div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Description</th>
        <th style="text-align: right;">Amount</th>
        <th style="text-align: right;">Currency</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>{{ invoice.description }}</td>
        <td style="text-align: right;">{{ "%.2f" | format(invoice.amount) }}</td>
        <td style="text-align: right;">{{ invoice.currency | upper }}</td>
      </tr>
      <tr class="amount-row">
        <td>Total</td>
        <td style="text-align: right;">{{ "%.2f" | format(invoice.amount) }}</td>
        <td style="text-align: right;">{{ invoice.currency | upper }}</td>
      </tr>
    </tbody>
  </table>

  <div class="footer">
    This invoice was generated automatically. Please contact support if you have any questions.
  </div>

</body>
</html>
