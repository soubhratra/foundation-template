{
  "name": "@repo/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "echo 'Detox E2E tests require iOS simulator - run: pnpm test:e2e:build && pnpm test:e2e:run'",
    "test:e2e:build": "detox build -c ios.sim.debug",
    "test:e2e:run": "detox test -c ios.sim.debug"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@repo/business-logic": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/validation": "workspace:*",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "expo": "~52.0.0",
    "expo-apple-authentication": "~7.1.3",
    "expo-application": "~6.0.2",
    "expo-constants": "~17.0.0",
    "expo-device": "~7.0.3",
    "expo-file-system": "~18.0.12",
    "expo-linking": "~7.0.0",
    "expo-localization": "~16.0.1",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~13.0.0",
    "expo-status-bar": "~2.0.0",
    "lucide-react-native": "^0.564.0",
    "posthog-react-native": "^4.37.2",
    "react": "18.3.1",
    "react-hook-form": "^7.71.1",
    "react-native": "~0.76.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "^15.15.3",
    "react-native-web": "~0.19.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@repo/config-eslint": "workspace:*",
    "@repo/config-ts": "workspace:*",
    "@types/react": "^19.0.0",
    "detox": "^20.47.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0"
  }
}
